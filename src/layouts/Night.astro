---
// Shared shell for every page in the night world.
import '../styles/night.css';

interface Props {
  title: string;
  description: string;
  accent?: string;
}
const { title, description, accent = '#ffe066' } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060a1c" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/sprites/cecil.png" as="image" />
  </head>
  <body style={`--accent:${accent}`}>
    <slot />
  </body>
</html>
